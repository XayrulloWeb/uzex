# Set real values through your hosting/cloud environment secret settings.
# This file contains variable NAMES only; do not commit real keys.
# For local use, server/app.py loads a private .env file; process variables take priority.
UZEX_GEMINI_KEY_PRIMARY=
UZEX_GEMINI_KEY_BACKUP=
# Optional preferred models; available text models are checked by Gemini discovery.
UZEX_GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro
