    "sql": "SELECT year(deal_date) AS id,year(deal_date) AS label,count(*) AS deals,coalesce(sum(amount_uzs),0) AS amount,\n        count(*) FILTER (WHERE contract_type=?) AS target_deals,\n        coalesce(sum(amount_uzs) FILTER (WHERE contract_type=?),0) AS target_amount,\n        min(deal_date) AS first_date,max(deal_date) AS last_date\n        FROM trades WHERE TRUE AND deal_date>=? AND deal_date<=? AND year(deal_date) IN (?,?) GROUP BY year(deal_date) ORDER BY id LIMIT ?",
